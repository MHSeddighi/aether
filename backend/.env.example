# Copy to backend/.env and adjust. Never commit real keys.
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Postgres ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/botbuilder

# --- Temporal ---
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=bot-builder
TEMPORAL_BUILD_TASK_QUEUE=bot-builder-build

# --- Auth ---
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000

# --- Models ---
# Free-model availability is dynamic; change these without touching code.
DEFAULT_PROVIDER=opencode
DEFAULT_MODEL_ID=space-bunny-free
DEFAULT_TEMPERATURE=0.3
DEFAULT_MAX_OUTPUT_TOKENS=2048
MODEL_TIMEOUT_SECONDS=60

# OpenCode Zen (serves some models keyless; key optional)
OPENCODE_API_KEY=
# OpenRouter (key required)
OPENROUTER_API_KEY=
# DeepSeek adapter ships in code but is not configured by default.
DEEPSEEK_API_KEY=

# --- Sandbox (State 10) ---
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_NETWORK=none
SANDBOX_CPUS=1.0
SANDBOX_MEMORY=256m
